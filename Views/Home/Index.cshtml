.destination-card {
    position: relative;
    height: 300px; /* Set fixed height */
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
}

.destination-card:hover {
    transform: scale(1.05);
}

.destination-card img {
    width: 100%;
    height: 100%; /* Ensure image fills the card height */
    object-fit: cover; /* Cover ensures the image will cover the area, cropping if necessary */
    transition: opacity 0.3s ease;
}

.destination-name {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    background-color: rgba(0, 0, 0, 0.5);
    color: white;
    padding: 10px;
    text-align: center;
    font-size: 1.1rem;
    font-weight: bold;
}

.destination-name p {
    margin: 0;
}

