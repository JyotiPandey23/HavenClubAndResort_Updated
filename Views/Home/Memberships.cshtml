<!-- CTA Section -->
<section class="cta-section">
    <div class="container">
        <h2 class="cta-title">Ready to Begin Your Haven Journey?</h2>
        <p>Join our exclusive membership today and start enjoying the benefits immediately.</p>
        <button class="cta-button" data-bs-toggle="modal" data-bs-target="#membershipModal">Become a Member</button>
    </div>
</section>

<!-- Membership Modal -->
<div class="modal fade membership-modal" id="membershipModal" tabindex="-1" aria-labelledby="membershipModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="membershipModalLabel">Join Haven Club</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <input type="text" class="form-control" id="memberName" placeholder=" " required>
                            <label for="memberName" class="form-label">Full Name</label>
                        </div>
                        <div class="col-md-6">
                            <input type="email" class="form-control" id="memberEmail" placeholder=" " required>
                            <label for="memberEmail" class="form-label">Email Address</label>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <input type="tel" class="form-control" id="memberPhone" placeholder=" " required>
                            <label for="memberPhone" class="form-label">Phone Number</label>
                        </div>
                        <div class="col-md-6">
                            <select class="form-select" id="membershipType" required>
                                <option value="" selected disabled>Select Membership</option>
                                <option value="blue">Blue Membership (₹75,000)</option>
                                <option value="green">Green Membership (₹1,25,000)</option>
                                <option value="orange">Orange Membership (₹3,00,000)</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <input type="text" class="form-control" id="memberCity" placeholder=" ">
                            <label for="memberCity" class="form-label">City</label>
                        </div>
                        <div class="col-md-6">
                            <input type="text" class="form-control" id="memberCountry" placeholder=" ">
                            <label for="memberCountry" class="form-label">Country</label>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <textarea class="form-control" id="memberNotes" rows="3" placeholder=" "></textarea>
                        <label for="memberNotes" class="form-label">Special Requests or Questions</label>
                    </div>
                    
                    <div class="text-center">
                        <button type="submit" class="btn btn-accent px-5 py-2">Submit Application</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>