            <div class="destination-card">
                <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80" alt="Mountains" class="destination-image">
                <div class="destination-overlay">
                    <h3>Mountains</h3>
                    <p>Breathtaking peaks and serene valleys</p>
                </div>
            </div>
            
            <div class="destination-card">
                <img src="~/assets/images/Aisa/forest (3).jpg" alt="Forest" class="destination-image">
                <div class="destination-overlay">
                    <h3>Forest</h3>
                    <p>Immerse yourself in nature's tranquility</p>
                </div>
            </div>
            
            <div class="destination-card">
                <img src="~/assets/images/Aisa/asia1.jpg" alt="Asia" class="destination-image">
                <div class="destination-overlay">
                    <h3>Asia</h3>
                    <p>Diverse cultures and ancient wonders</p>
                </div>
            </div>
            
            <div class="destination-card">
                <img src="~/assets/images/Aisa/europe (2).jpg" alt="Europe" class="destination-image">
                <div class="destination-overlay">
                    <h3>Europe</h3>
                    <p>Timeless elegance and modern luxury</p>
                </div>
            </div>
        </div>
    </div>
</section>

