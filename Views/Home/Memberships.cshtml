    <div class="container">
        <span class="nexus-section-badge">Explore</span>
        <h2 class="section-title">Featured Destinations</h2>
        
        <div class="destinations-grid">
            <div class="destination-card">
                <img src="~/assets/images/Aisa/heritage.jpg" alt="Indian Heritage" class="destination-image">
                <div class="destination-overlay">
                    <h3>Indian Heritage</h3>
                    <p>Explore the rich cultural tapestry of India</p>
                </div>
            </div>
            
            <div class="destination-card">
                <img src="https://images.unsplash.com/photo-1503917988258-f87a78e3c995?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1887&q=80" alt="Beaches" class="destination-image">
                <div class="destination-overlay">
                    <h3>Beaches</h3>
                    <p>Pristine shores and turquoise waters</p>
