<!-- Hero Section -->
<section class="membership-hero" style="background: linear-gradient(rgba(6, 7, 8, 0.9), rgba(11, 15, 20, 0.7)), url('/assets/images/Aisa/traveler.jpg'); background-size: cover; background-position: center; height: 100vh; margin: 0; display: flex; justify-content: center; align-items: center; color: white; font-family: Arial, sans-serif;">
    <div class="membership-hero-content">
        <span class="nexus-section-badge">Exclusive Access</span>
        <h1>Membership Plan</h1>
        <p>Unlock a world of luxury travel with our exclusive membership plans designed for discerning travelers who value comfort, convenience, and unforgettable experiences.</p>
    </div>
</section>

<!-- Benefits Section -->
<section class="benefits-section">
    <div class="container">
        <span class="nexus-section-badge">Why Choose Haven Club And Private Limited</span>
        <h2 class="section-title">Membership Benefits</h2>
        
        <div class="benefits-grid">
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="fas fa-medal"></i>
                </div>
                <h3>Exclusive Rates</h3>
                <p>Enjoy member-only pricing on all our resorts and partner properties worldwide, with savings up to 40% off standard rates.</p>
            </div>
            
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="fas fa-calendar-star"></i>
                </div>
                <h3>Priority Booking</h3>
                <p>Get early access to book peak season dates and special events before they're available to the general public.</p>
            </div>
            
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="fas fa-gift"></i>
                </div>
                <h3>Complimentary Upgrades</h3>
                <p>Receive automatic room upgrades when available, plus welcome amenities at every Haven property.</p>
            </div>
            
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="fas fa-plane"></i>
                </div>
                <h3>Travel Credits</h3>
                <p>Earn annual travel credits redeemable for room nights, spa services, dining, and more across our network.</p>
            </div>
            
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="fas fa-concierge-bell"></i>
                </div>
                <h3>Dedicated Concierge</h3>
                <p>24/7 access to our member services team for personalized trip planning and special requests.</p>
            </div>
            
            <div class="benefit-card">
                <div class="benefit-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <h3>Flexible Cancellation</h3>
                <p>Enjoy more generous cancellation policies and last-minute changes without penalties.</p>
            </div>
        </div>
    </div>
</section>

<!-- Plans Section -->
<section class="plans-section">
    <div class="container">
        <span class="nexus-section-badge">Choose Your Plan</span>
        <h2 class="section-title">Membership Options</h2>
        
        <div class="plans-grid">
            <!-- Blue Membership -->
            <div class="plan-card blue-plan">
                <div class="plan-header">
                    <h3 class="plan-name">Blue Membership</h3>
                    <div class="plan-price">₹75,000</div>
                    <div class="plan-duration">3 Years</div>
                </div>
                <div class="plan-body">
                    <ul class="plan-features">
                        <li>India destinations only</li>
                        <li>6 Nights / 7 Days yearly</li>
                        <li>4 Star properties</li>
                        <li>Accommodations only</li>
                        <li>₹8,333 annual AMC</li>
                        <li>Priority check-in</li>
                    </ul>
                    <button class="plan-button" data-bs-toggle="modal" data-bs-target="#membershipModal">Join Now</button>
                </div>
            </div>
            
            <!-- Green Membership -->
            <div class="plan-card green-plan">
                <div class="plan-header">
                    <h3 class="plan-name">Green Membership</h3>
                    <div class="plan-price">₹1,25,000</div>
                    <div class="plan-duration">5 Years</div>
                </div>
                <div class="plan-body">
                    <ul class="plan-features">
                        <li>India + Asia destinations</li>
                        <li>6 Nights / 7 Days yearly</li>
                        <li>4 Star properties</li>
                        <li>Accommodations only</li>
                        <li>₹6,999 annual AMC</li>
                        <li>Complimentary breakfast</li>
                    </ul>
                    <button class="plan-button" data-bs-toggle="modal" data-bs-target="#membershipModal">Join Now</button>
                </div>
            </div>
            
            <!-- Orange Membership -->
            <div class="plan-card orange-plan">
                <div class="plan-header">
                    <h3 class="plan-name">Orange Membership</h3>
                    <div class="plan-price">₹3,00,000</div>
                    <div class="plan-duration">10 Years</div>
                </div>
                <div class="plan-body">
                    <ul class="plan-features">
                        <li>India + Asia + Europe</li>
                        <li>6 Nights / 7 Days yearly</li>
                        <li>4 & 5 Star properties</li>
                        <li>Accommodations + some meals</li>
                        <li>₹5,999 annual AMC</li>
                        <li>Spa credit included</li>
                    </ul>
                    <button class="plan-button" data-bs-toggle="modal" data-bs-target="#membershipModal">Join Now</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="testimonials-section">
    <div class="container">
        <span class="nexus-section-badge">Member Stories</span>
        <h2 class="section-title">What Our Members Say</h2>
        
        <div class="testimonial-slider">
            <div class="testimonial">
                <p class="testimonial-text">Our Orange Membership has completely transformed how we travel. The properties are exquisite, the service impeccable, and the value is unbeatable. We've already saved more than our membership cost in just two vacations!</p>
                <h4>— The Jaisawal Family</h4>
            </div>
            
            <div class="testimonial">
                <p class="testimonial-text">As frequent travelers, the Green Membership was the perfect choice for us. The Asian properties are stunning, and the dedicated concierge has helped us plan trips we could never have arranged on our own. Worth every rupee!</p>
                <h4>— Mr. Vikram Mehta</h4>
            </div>
        </div>
    </div>
</section>

<!-- Destinations Section -->
