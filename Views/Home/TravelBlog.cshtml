<script>
    $(document).ready(function(){
        // Initialize testimonial slider
        $('.testimonial-slider').slick({
            dots: true,
            arrows: false,
            infinite: true,
            speed: 300,
            slidesToShow: 1,
            adaptiveHeight: true,
            autoplay: true,
            autoplaySpeed: 5000
        });

        // Map pin hover effect
        $('.map-pin').hover(function(){
            $(this).find('.pin-tooltip').css({
                'opacity': '1',
                'visibility': 'visible',
                'bottom': '40px'
            });
        }, function(){
            $(this).find('.pin-tooltip').css({
                'opacity': '0',
                'visibility': 'hidden',
                'bottom': '30px'
            });
        });
    });
</script>