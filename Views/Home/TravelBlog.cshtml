<!-- Travel Tips -->
<section class="travel-tips">
    <div class="container">
        <div class="section-heading text-center">
            <span class="subtitle">Travel Smart</span>
            <h2 class="title">Essential Travel Tips</h2>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-6">
                <div class="tip-card">
                    <div class="tip-icon">
                        <i class="fas fa-passport"></i>
                    </div>
                    <h4>Documentation</h4>
                    <p>Always keep copies of your passport and important documents in separate locations.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="tip-card">
                    <div class="tip-icon">
                        <i class="fas fa-suitcase-rolling"></i>
                    </div>
                    <h4>Packing</h4>
                    <p>Pack light but include versatile clothing items that can be layered.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="tip-card">
                    <div class="tip-icon">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>
                    <h4>Currency</h4>
                    <p>Carry multiple forms of payment and notify your bank of travel plans.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="tip-card">
                    <div class="tip-icon">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <h4>Health</h4>
                    <p>Research any required vaccinations and pack a basic medical kit.</p>
                </div>
            </div>
        </div>
    </div>
</section>

