<!DOCTYPE html>
<html lang="en">
<!-- In _Layout.cshtml -->
<head>
    <!-- Font Awesome 6 Free -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="~/assets/css/layout_style.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Then page-specific styles -->
    @RenderSection("Styles", required: false)
</head>
<body>
    @Html.Partial("_BodyModalPartialView")

    <!-- HTML -->
<header class="haven-header">
    <nav class="haven-navbar">
        <div class="haven-container">
            <a class="haven-logo" href="/">
                    <img src="~/assets/images/transparent .png" alt="Haven Club And Resorts Private Limited">
            </a>
            <button class="haven-menu-toggle" type="button" aria-label="Toggle navigation">
                <span class="haven-hamburger"></span>
            </button>
            <div class="haven-nav-menu">
                <ul class="haven-nav-list">
                    <li class="haven-nav-item active">
                        <a class="haven-nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="haven-nav-item">
                        <a class="haven-nav-link" asp-controller="Home" asp-action="AboutUs">About Us</a>
                    </li>
                     <!-- Update the Destination menu item in your navigation -->
                     <li class="haven-nav-item haven-dropdown">
                            <a class="haven-nav-link" asp-controller="Home" asp-action="Destination">
                                Destination
                                <i class="fas fa-chevron-down dropdown-arrow"></i>
                            </a>
                            <ul class="haven-submenu">
                                <li class="haven-nav-item haven-nested-dropdown">
                                    <a class="haven-nav-link" asp-controller="Home" asp-action="Destination">
                                        Domestic
                                        <i class="fas fa-chevron-right nested-dropdown-arrow"></i>
                                    </a>
                                    <ul class="haven-nested-submenu">
                                        <li class="haven-nav-item">
                                            <a class="haven-nav-link" asp-controller="Home" asp-action="NorthZone">North Zone</a>
                                        </li>
                                        <li class="haven-nav-item">
                                            <a class="haven-nav-link" asp-controller="Home" asp-action="SouthZone">South Zone</a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="haven-nav-item haven-nested-dropdown">
                                    <a class="haven-nav-link" asp-controller="Home" asp-action="Destination">
                                        International
                                        <i class="fas fa-chevron-right nested-dropdown-arrow"></i>
                                    </a>
                                    <ul class="haven-nested-submenu">
                                        <li class="haven-nav-item">
                                            <a class="haven-nav-link" asp-controller="Home" asp-action="AsiaZone" >Asia</a>
                                        </li>
                                        <li class="haven-nav-item">
                                            <a class="haven-nav-link" asp-controller="Home" asp-action="EuropeZone">Europe</a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                    <li class="haven-nav-item">
                        <a class="haven-nav-link" asp-controller="Home" asp-action="Memberships">Membership Plan</a>
                    </li>
                    <li class="haven-nav-item">
                        <a class="haven-nav-link" asp-controller="Home" asp-action="ContatUs">Contact Us</a>
                    </li>
                    <li class="haven-nav-item">
                        <a class="haven-nav-link" asp-controller="Home" asp-action="TravelBlog">Travel Blog</a>
                    </li>
                    <li class="haven-nav-item">
                        <a class="haven-nav-link" asp-controller="Home" asp-action="MemberLogin">Member Login</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>


    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Call to Action -->
    <section class="haven-cta-section text-center">
        <img src="~/assets/images/back.jpg" alt="Call to Action Background" class="haven-cta-bg">
        <div class="container">
            <div class="row justify-content-center" data-aos="zoom-in">
                <div class="col-lg-8">
                    <h3 class="haven-cta-title">Give Us a Ring: We're Ready to Help!</h3>
                    <p class="haven-cta-text mb-4">The world is a book, and those who do not travel read only one page.</p>
                    <a href="tel:18002122750" class="haven-cta-btn">
                        <i class="fas fa-phone-alt mr-2"></i> 18002122750
                    </a>
                </div>
            </div>
        </div>
    </section>

    <footer class="haven-footer">
        <div class="footer-wave">
            <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z"
                      opacity=".25" fill="var(--haven-primary)"></path>
                <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z"
                      opacity=".5" fill="var(--haven-primary)"></path>
                <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z"
                      fill="var(--haven-primary)"></path>
            </svg>
        </div>
        <div class="container">
            <div class="footer-grid">
                <!-- About Column -->
                <div class="footer-col footer-about">
                    <div class="footer-logo">
                        <img src="~/assets/images/transparent .png" alt="Haven Club And Resorts Private Limited" class="logo-img">
                    </div>
                    <p class="footer-description">We offer unforgettable family holidays in India and Asia at budget friendly prices. Create lasting memories year after year with our vacation ownership memberships.</p>
                    <div class="footer-newsletter">
                        <h5>Subscribe to Newsletter</h5>
                        <form class="newsletter-form">
                            <input type="email" placeholder="Your email address" required>
                            <button type="submit"><i class="fas fa-paper-plane"></i></button>
                        </form>
                    </div>
                </div>

                <!-- Quick Links Column -->
                <div class="footer-col footer-links">
                    <h4 class="footer-title">Quick Links</h4>
                    <div class="links-grid">
                        <ul class="links-list">
                            <li><a asp-controller="Home" asp-action="index"><i class="fas fa-chevron-right"></i> Home</a></li>
                            <li><a asp-controller="Home" asp-action="AboutUs"><i class="fas fa-chevron-right"></i> About Us</a></li>
                            <li><a asp-controller="Home" asp-action="Destination"><i class="fas fa-chevron-right"></i> Destinations</a></li>
                            <li><a asp-controller="Home" asp-action="Memberships"><i class="fas fa-chevron-right"></i> Membership Plans</a></li>
                        </ul>
                        <ul class="links-list">
                            <li><a asp-controller="Home" asp-action="ContatUs"><i class="fas fa-chevron-right"></i> Contact Us</a></li>
                            <li><a asp-controller="Home" asp-action="TravelBlog"><i class="fas fa-chevron-right"></i> Travel Blog</a></li>
                            <li><a asp-controller="Home" asp-action="termsCondition"><i class="fas fa-chevron-right"></i> Term and Condition</a></li>
                          
                            <li><a asp-controller="Home" asp-action="PrivacyAndPolicy"><i class="fas fa-chevron-right"></i> Privacy Policy</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Contact Column -->
                <div class="footer-col footer-contact">
                    <h4 class="footer-title">Contact Us</h4>
                    <ul class="contact-list">
                        <li>
                            <div class="contact-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="contact-text">
                                Sun West Bank Ashram Road, B 1322, Ashram Road, Sadar Bazar, Ahmedabad, Gujarat 380009
                            </div>
                        </li>
                        <li>
                            <div class="contact-icon">
                                <i class="fas fa-phone-alt"></i>
                            </div>
                            <div class="contact-text">
                                <a href="tel: 18002122750"> 18002122750</a>
                            </div>
                        </li>
                        <li>
                            <div class="contact-icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="contact-text">
                                <a href="mailto:xyz@gmail.com">info@havenclubandresorts.in</a>
                                <br/>
                                <a href="mailto:xyz@gmail.com">reservation@havenclubandresorts.in</a>
                            </div>
                        </li>
                    </ul>

                    <div class="payment-methods">
                        <h5>We Accept</h5>
                        <div class="payment-icons">
                            <i class="fab fa-cc-visa"></i>
                            <i class="fab fa-cc-mastercard"></i>
                            <i class="fab fa-cc-paypal"></i>
                            <i class="fab fa-cc-amex"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Social and Copyright -->
            <div class="footer-bottom">
                <div class="social-links">
                    <a href="#" class="social-icon" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-icon" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="social-icon" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="social-icon" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" class="social-icon" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                    <a href="#" class="social-icon" aria-label="Pinterest"><i class="fab fa-pinterest-p"></i></a>
                </div>

                <div class="copyright">
                    <p>&copy; @DateTime.Now.Year Haven Club And Resorts Private Limited Pvt. Ltd. All Rights Reserved.</p>
                    <div class="legal-links">
                        <a href="#">Privacy Policy</a>
                        <a href="#">Terms of Service</a>
                        <a href="#">Cookie Policy</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Back to Top Button -->
    <a href="#" id="back-to-top" class="back-to-top" title="Back to top">
        <i class="fas fa-arrow-up"></i>
    </a>

    <!-- JavaScript Libraries -->
    <script src="~/assets/js/jquery-3.2.1.min.js"></script>
    <script src="~/assets/js/popper.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <script>
        // Initialize AOS animations
        AOS.init({
            duration: 800,
            easing: 'ease-in-out'
        });

        // Show modal once per session
        $(document).ready(function () {
            if (!sessionStorage.getItem("modalShown")) {
                $('#inquiryModal').modal('show');
                sessionStorage.setItem("modalShown", "true");
            }

            // Back to top button
            $(window).scroll(function () {
                if ($(this).scrollTop() > 100) {
                    $('#back-to-top').fadeIn();
                } else {
                    $('#back-to-top').fadeOut();
                }
            });

            $('#back-to-top').click(function () {
                $('html, body').animate({ scrollTop: 0 }, 800);
                return false;
            });
        });

        // Enhanced mobile menu functionality with dropdown support
        document.addEventListener('DOMContentLoaded', function () {
            const menuToggle = document.querySelector('.haven-menu-toggle');
            const navMenu = document.querySelector('.haven-nav-menu');
            const dropdowns = document.querySelectorAll('.haven-dropdown, .haven-nested-dropdown');

            // Toggle main menu
            menuToggle.addEventListener('click', function () {
                this.classList.toggle('active');
                navMenu.classList.toggle('active');

                // Toggle body overflow when menu is open
                if (navMenu.classList.contains('active')) {
                    document.body.style.overflow = 'hidden';
                } else {
                    document.body.style.overflow = '';
                    // Close all dropdowns when closing main menu
                    dropdowns.forEach(dropdown => {
                        dropdown.classList.remove('active');
                        const submenu = dropdown.querySelector('.haven-submenu, .haven-nested-submenu');
                        if (submenu) submenu.style.display = 'none';
                    });
                }
            });

            // Desktop hover functionality for dropdowns
            dropdowns.forEach(dropdown => {
                // Desktop hover
                dropdown.addEventListener('mouseenter', function () {
                    if (window.innerWidth > 991) {
                        const submenu = this.querySelector('.haven-submenu, .haven-nested-submenu');
                        if (submenu) {
                            submenu.style.opacity = '1';
                            submenu.style.visibility = 'visible';
                            submenu.style.transform = 'translateY(0)';

                            const arrow = this.querySelector('.dropdown-arrow, .nested-dropdown-arrow');
                            if (arrow) {
                                arrow.style.transform = 'rotate(180deg)';
                            }
                        }
                    }
                });

                dropdown.addEventListener('mouseleave', function () {
                    if (window.innerWidth > 991) {
                        const submenu = this.querySelector('.haven-submenu, .haven-nested-submenu');
                        if (submenu) {
                            submenu.style.opacity = '0';
                            submenu.style.visibility = 'hidden';
                            submenu.style.transform = 'translateY(10px)';

                            const arrow = this.querySelector('.dropdown-arrow, .nested-dropdown-arrow');
                            if (arrow) {
                                arrow.style.transform = '';
                            }
                        }
                    }
                });

                // Mobile click functionality
                const link = dropdown.querySelector('a');
                const arrow = dropdown.querySelector('.dropdown-arrow, .nested-dropdown-arrow');
                const subMenu = dropdown.querySelector('.haven-submenu, .haven-nested-submenu');

                link.addEventListener('click', function (e) {
                    if (window.innerWidth <= 991) {
                        e.preventDefault();
                        dropdown.classList.toggle('active');

                        // Toggle submenu display
                        if (subMenu) {
                            if (dropdown.classList.contains('active')) {
                                subMenu.style.display = 'block';
                            } else {
                                subMenu.style.display = 'none';
                            }
                        }

                        // Rotate arrow
                        if (arrow) {
                            arrow.style.transform = dropdown.classList.contains('active') ?
                                (arrow.classList.contains('nested-dropdown-arrow') ? 'rotate(270deg)' : 'rotate(180deg)') :
                                (arrow.classList.contains('nested-dropdown-arrow') ? 'rotate(90deg)' : '');
                        }

                        // Close other dropdowns at the same level
                        const siblings = Array.from(dropdown.parentElement.children).filter(child => child !== dropdown);
                        siblings.forEach(sibling => {
                            sibling.classList.remove('active');
                            const siblingArrow = sibling.querySelector('.dropdown-arrow, .nested-dropdown-arrow');
                            const siblingSubmenu = sibling.querySelector('.haven-submenu, .haven-nested-submenu');
                            if (siblingArrow) {
                                siblingArrow.style.transform = '';
                            }
                            if (siblingSubmenu) {
                                siblingSubmenu.style.display = 'none';
                            }
                        });
                    }
                });
            });

            // Close menu when clicking outside or on a link
            document.addEventListener('click', function (event) {
                const isClickInsideMenu = navMenu.contains(event.target);
                const isClickOnToggle = menuToggle.contains(event.target);

                if (!isClickInsideMenu && !isClickOnToggle && navMenu.classList.contains('active')) {
                    menuToggle.classList.remove('active');
                    navMenu.classList.remove('active');
                    document.body.style.overflow = '';

                    // Close all dropdowns
                    dropdowns.forEach(dropdown => {
                        dropdown.classList.remove('active');
                        const arrow = dropdown.querySelector('.dropdown-arrow, .nested-dropdown-arrow');
                        const submenu = dropdown.querySelector('.haven-submenu, .haven-nested-submenu');
                        if (arrow) {
                            arrow.style.transform = '';
                        }
                        if (submenu) {
                            submenu.style.display = 'none';
                        }
                    });
                }
            });

            // Close menu when clicking on a link (for mobile)
            const navLinks = document.querySelectorAll('.haven-nav-link:not(.haven-dropdown > a):not(.haven-nested-dropdown > a)');
            navLinks.forEach(link => {
                link.addEventListener('click', function () {
                    if (window.innerWidth <= 991) {
                        menuToggle.classList.remove('active');
                        navMenu.classList.remove('active');
                        document.body.style.overflow = '';
                    }
                });
            });

            // Set active menu item based on current page
            function setActiveMenuItem() {
                const currentPath = window.location.pathname;
                const navItems = document.querySelectorAll('.haven-nav-item');

                navItems.forEach(item => {
                    const link = item.querySelector('.haven-nav-link');
                    if (link) {
                        const linkPath = link.getAttribute('href');

                        // Remove active class from all items first
                        item.classList.remove('active');

                        // Check if current path matches link path
                        if (currentPath === linkPath ||
                            (currentPath.startsWith(linkPath) && linkPath !== '/')) {
                            item.classList.add('active');
                        }
                    }
                });
            }

            // Set active menu item on page load
            setActiveMenuItem();
        });

        // Back to Top Functionality
        document.addEventListener('DOMContentLoaded', function () {
            const backToTopButton = document.getElementById('back-to-top');

            // Show/hide button based on scroll position
            window.addEventListener('scroll', function () {
                if (window.pageYOffset > 300) {
                    backToTopButton.classList.add('active');
                } else {
                    backToTopButton.classList.remove('active');
                }
            });

            // Smooth scroll to top
            backToTopButton.addEventListener('click', function (e) {
                e.preventDefault();
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });

                // Add click animation
                this.classList.add('clicked');
                setTimeout(() => {
                    this.classList.remove('clicked');
                }, 300);
            });
        });
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>